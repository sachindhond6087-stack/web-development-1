<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>E-Commerce Product Page</title>

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family: Arial, sans-serif;
    }

    body{
      background:#f4f4f4;
    }

    header{
      background:#222;
      color:white;
      padding:15px 40px;
      display:flex;
      justify-content:space-between;
      align-items:center;
    }

    header h1{
      color:#ff9800;
    }

    nav a{
      color:white;
      text-decoration:none;
      margin-left:20px;
      font-size:16px;
    }

    .container{
      width:90%;
      max-width:1200px;
      margin:40px auto;
    }

    .product-section{
      display:flex;
      flex-wrap:wrap;
      gap:30px;
      background:white;
      padding:30px;
      border-radius:10px;
      box-shadow:0 0 10px rgba(0,0,0,0.1);
    }

    .product-image{
      flex:1;
      min-width:300px;
    }

    .product-image img{
      width:100%;
      border-radius:10px;
    }

    .product-details{
      flex:1;
      min-width:300px;
    }

    .product-details h2{
      font-size:32px;
      margin-bottom:15px;
    }

    .price{
      color:green;
      font-size:28px;
      margin-bottom:15px;
    }

    .old-price{
      text-decoration:line-through;
      color:gray;
      font-size:18px;
      margin-left:10px;
    }

    .description{
      margin-bottom:20px;
      line-height:1.6;
      color:#555;
    }

    .rating{
      color:gold;
      margin-bottom:20px;
      font-size:20px;
    }

    .buttons button{
      padding:12px 25px;
      border:none;
      margin-right:15px;
      font-size:16px;
      border-radius:5px;
      cursor:pointer;
      transition:0.3s;
    }

    .cart-btn{
      background:#ff9800;
      color:white;
    }

    .buy-btn{
      background:#28a745;
      color:white;
    }

    .buttons button:hover{
      opacity:0.8;
    }

    .features{
      margin-top:25px;
    }

    .features h3{
      margin-bottom:10px;
    }

    .features ul{
      margin-left:20px;
      color:#444;
    }

    footer{
      margin-top:50px;
      background:#222;
      color:white;
      text-align:center;
      padding:20px;
    }

    @media(max-width:768px){
      .product-section{
        flex-direction:column;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1>ShopEasy</h1>

    <nav>
      <a href="#">Home</a>
      <a href="#">Products</a>
      <a href="#">Offers</a>
      <a href="#">Contact</a>
    </nav>
  </header>

  <div class="container">

    <div class="product-section">

      <div class="product-image">
        <img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?q=80&w=1000"
             alt="Product Image">
      </div>

      <div class="product-details">

        <h2>Running Shoes</h2>

        <div class="price">
          ₹2,499
          <span class="old-price">₹3,999</span>
        </div>

        <div class="rating">
          ★★★★☆ (4.5/5)
        </div>

        <p class="description">
          Premium quality running shoes designed for comfort and durability.
          Perfect for sports, gym workouts, and casual wear.
        </p>

        <div class="buttons">
          <button class="cart-btn" onclick="addToCart()">
            Add to Cart
          </button>

          <button class="buy-btn" onclick="buyNow()">
            Buy Now
          </button>
        </div>

        <div class="features">
          <h3>Product Features:</h3>

          <ul>
            <li>Lightweight and breathable material</li>
            <li>Non-slip rubber sole</li>
            <li>Available in multiple sizes</li>
            <li>1 Year Warranty</li>
          </ul>
        </div>

      </div>

    </div>

  </div>

  <footer>
    <p>© 2026 ShopEasy. All Rights Reserved.</p>
  </footer>

  <script>

    function addToCart(){
      alert("Product added to cart!");
    }

    function buyNow(){
      alert("Proceeding to checkout...");
    }

  </script>

</body>
</html>
